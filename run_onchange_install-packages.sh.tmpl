#!/usr/bin/env bash
# Linux 侧的一键安装。内容一改，chezmoi 就会在所有机器上重跑本脚本。
set -euo pipefail

# chezmoi 用非交互 shell 跑本脚本，家目录下的 bin 不在默认 PATH 里。
# 不先补齐，have cargo/uv/pi 全为假，每次 apply 都会重装一遍。
# 倒序 prepend，最终顺序为 ~/.cargo/bin:~/.local/bin:~/.local/share/pnpm
for d in "$HOME/.local/share/pnpm" "$HOME/.local/bin" "$HOME/.cargo/bin"; do
  if [ -d "$d" ]; then
    case ":$PATH:" in
      *":$d:"*) ;;
      *)        PATH="$d:$PATH" ;;
    esac
  fi
done
export PATH

have() { command -v "$1" >/dev/null 2>&1; }
. /etc/os-release

case "${ID:-} ${ID_LIKE:-}" in
  *arch*)             pm=pacman ;;
  *fedora*|*rhel*)    pm=dnf ;;
  *ubuntu*|*debian*)  pm=apt ;;
  *) echo "未识别的发行版: ${PRETTY_NAME:-unknown}"; exit 1 ;;
esac

pkg() {
  case "$pm" in
    pacman) sudo pacman -S --needed --noconfirm "$@" ;;
    dnf)    sudo dnf install -y "$@" ;;
    apt)    sudo apt-get update -y && sudo apt-get install -y "$@" ;;
  esac
}

# 基础包 + npm
case "$pm" in
  pacman) pkg git neovim curl nodejs npm fish ;;
  dnf)    pkg git neovim curl nodejs npm fish ;;
  apt)    pkg git neovim curl nodejs npm fish ;;
esac

# Rust：统一走 rustup，避免发行版仓库里的旧版本
# 无代理时先指向 rsproxy 国内镜像，避免首次安装工具链龟速
if ! have cargo; then
  export RUSTUP_DIST_SERVER="https://rsproxy.cn"
  export RUSTUP_UPDATE_ROOT="https://rsproxy.cn/rustup"
  # PATH 由脚本开头统一补，--no-modify-path 保证不污染 shell 配置文件
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi

# pnpm
if ! have pnpm; then
  case "$pm" in
    pacman) pkg pnpm ;;
    dnf)    pkg pnpm ;;
    apt)    sudo npm install -g pnpm ;;
  esac
fi

# jj：优先发行版包 → 其次 GitHub 预编译二进制（静态 musl，约 1 分钟）→ 最后才 cargo 编译（十几分钟）
# GitHub Releases 直连在无代理时基本超时，所以按顺序试镜像，任一个成功即止。
jj_prebuilt() {
  local arch tag asset tmp base url
  case "$(uname -m)" in
    x86_64|amd64)  arch=x86_64-unknown-linux-musl ;;
    aarch64|arm64) arch=aarch64-unknown-linux-musl ;;
    *) return 1 ;;
  esac

  # 版本号：可用 JJ_VERSION=v0.46.0 固定，否则取 latest
  tag="${JJ_VERSION:-}"
  if [ -z "$tag" ]; then
    tag=$(curl -fsSL --connect-timeout 10 --max-time 20 https://api.github.com/repos/jj-vcs/jj/releases/latest 2>/dev/null \
          | sed -n 's/.*"tag_name": *"\(v[^"]*\)".*/\1/p' | head -n1) || true
  fi
  [ -n "$tag" ] || return 1

  asset="jj-${tag}-${arch}.tar.gz"
  tmp=$(mktemp -d)
  # 镜像优先：直连 GitHub 在无代理环境下要卡 2 分钟才报连不上，浪费时间。
  # --connect-timeout 让连不通的地址快速失败。
  for base in 'https://gh-proxy.com/' ''; do
    url="${base}https://github.com/jj-vcs/jj/releases/download/${tag}/${asset}"
    echo "取 jj 预编译包: $url"
    if curl -fsSL --connect-timeout 15 --max-time 300 -o "$tmp/$asset" "$url"; then
      mkdir -p "$tmp/x"
      tar xzf "$tmp/$asset" -C "$tmp/x"
      install -Dm755 "$tmp/x/jj" "$HOME/.local/bin/jj"
      rm -rf "$tmp"
      return 0
    fi
  done
  rm -rf "$tmp"
  return 1
}

if ! have jj; then
  pkg jujutsu || jj_prebuilt || cargo install --locked --bin jj jj-cli
fi

# fcitx5 + Rime：中文输入法（方案与模型由 run_onchange_after_10-rime-frost.sh 拉取）
if ! have fcitx5; then
  case "$pm" in
    dnf) pkg fcitx5 fcitx5-rime fcitx5-gtk fcitx5-qt fcitx5-configtool \
             librime-lua librime-octagram librime-predict ;;
    apt) pkg fcitx5 fcitx5-rime fcitx5-frontend-gtk3 fcitx5-frontend-qt5 fcitx5-config-qt || true ;;
    # Arch: pacman -S fcitx5-im fcitx5-rime（Arch 的 librime 已内置 lua/octagram 插件）
  esac
fi

# Python 3.12：用 uv 固定小版本，绕开各发行版自带 Python 版本不一致的问题
if ! have uv; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi
uv python install 3.12

# fish：设为默认登录 shell（只改当前用户的 passwd 条目，不动系统默认）
fish_bin="$(command -v fish || true)"
if [ -n "$fish_bin" ]; then
  current_shell="$(getent passwd "$USER" | cut -d: -f7)"
  if [ "$current_shell" != "$fish_bin" ]; then
    grep -qx "$fish_bin" /etc/shells || echo "$fish_bin" | sudo tee -a /etc/shells >/dev/null
    sudo chsh -s "$fish_bin" "$USER"
  fi
fi

# Pi coding agent：官方安装脚本，依赖版本固定，之后用 `pi update` 升级
if ! have pi; then
  curl -fsSL https://pi.dev/install.sh | sh
fi
